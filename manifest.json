{
  "manifest_version": 3,
  "name": "Block AI Overview",
  "version": "1.0",
  "description": "Removes AI Overview from Google searches by adding -ai to queries",
  "permissions": ["webNavigation"],
  "host_permissions": ["*://*.google.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.google.com/search*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "nobot_icon_128.png"
  }
}