{
  "manifest_version": 3,
  "name": "Block AI Overview",
  "version": "1.0.1",
  "description": "Removes AI Overview from Google searches by adding -ai to queries",
  "permissions": ["storage"],
  "host_permissions": ["*://*.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/search*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}